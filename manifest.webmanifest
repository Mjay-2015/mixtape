{
  "name": "Mixtape Player",
  "short_name": "Mixtape",
  "description": "Plays your own music files, offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#141218",
  "theme_color": "#1C1922",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".m4a",
          ".m4b"
        ],
        "audio/aac": [
          ".aac"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/ogg": [
          ".ogg",
          ".oga",
          ".opus"
        ],
        "audio/webm": [
          ".weba"
        ],
        "audio/aiff": [
          ".aif",
          ".aiff"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
